{
  "name": "octave-signup",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "test": "vitest run",
    "typecheck": "wrangler types --strict-vars=false --check && tsc --noEmit && tsc --noEmit -p test",
    "migrate:local": "wrangler d1 migrations apply octave-signup --local",
    "migrate:remote": "wrangler d1 migrations apply octave-signup --remote",
    "deploy": "wrangler d1 migrations apply octave-signup --remote && wrangler deploy"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.11",
    "@types/node": "^22.20.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.133.0"
  }
}
